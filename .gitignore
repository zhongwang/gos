# Public release allowlist. Working data, history, backups, and tools stay local.
/*
!/.gitattributes
!/.gitignore
!/LICENSE
!/NOTICE
!/README.md
!/requirements.txt
!/src/
!/examples/
!/models/

/src/*
!/src/__init__.py
!/src/__main__.py
!/src/gos/
/src/gos/*
!/src/gos/*.py

# Retired source trees are never published.
/src/v1/
/src/v2/
/src/v3/
/src/v4/

/examples/*
!/examples/README.md
!/examples/example.fasta
!/examples/example_manifest.json
!/examples/example_output.json

/models/*
!/models/gos_detector/
/models/gos_detector/*
!/models/gos_detector/README.md
!/models/gos_detector/decision_head.json
!/models/gos_detector/gos_detector_distilled_genomeocean_100m.pt

# Standalone architecture/tokenizer assets are fetched from Hugging Face.
# Local copies and release staging files are intentionally not published here.

__pycache__/
*.py[cod]
